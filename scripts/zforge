#!/bin/bash
# Z-FORGE Quick Launcher Wrapper
# Symlink this to /usr/local/bin/zforge for system-wide access

# Find the Z-FORGE directory
if [ -f "$HOME/github/Z-FORGE/zforge-launcher.sh" ]; then
    ZFORGE_DIR="$HOME/github/Z-FORGE"
elif [ -f "/opt/github/Z-FORGE/zforge-launcher.sh" ]; then
    ZFORGE_DIR="/opt/github/Z-FORGE"
elif [ -f "./zforge-launcher.sh" ]; then
    ZFORGE_DIR="$(pwd)"
else
    echo "Error: Cannot find Z-FORGE installation!"
    echo "Searched in:"
    echo "  - $HOME/github/Z-FORGE"
    echo "  - /opt/github/Z-FORGE"
    echo "  - Current directory"
    exit 1
fi

# Launch the TUI
cd "$ZFORGE_DIR" && exec ./zforge-launcher.sh "$@"